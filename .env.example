# Application
APP_ENV=development
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / PostGIS / TimescaleDB
DATABASE_URL=postgresql+psycopg://mdis:change-me@localhost:5432/mdis

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine (backend only)
GEE_PROJECT_ID=gee-pbl
# Service-account mode: configure both values below.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
# ADC mode: run `gcloud auth application-default login` outside the app.
GEE_USE_ADC=true
GEE_REQUEST_TIMEOUT_SECONDS=120

# Authentication (replace in every deployed environment)
AUTH_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=false

